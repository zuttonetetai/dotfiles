{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/terminal-notifier-for-claude.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/terminal-notifier-for-claude.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "statusLine": {
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline.sh",
    "type": "command"
  }
}